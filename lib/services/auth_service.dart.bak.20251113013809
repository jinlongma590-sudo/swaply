      final isNew = existing == null;

      // Facebook 鐧诲綍鍚庣‘淇?profile + 娆㈣繋鍒?
      await ProfileService.instance.ensureProfileAndWelcome(
        userId: user.id,
        email: user.email,
        fullName: user.userMetadata?['name'] ?? user.userMetadata?['full_name'],
