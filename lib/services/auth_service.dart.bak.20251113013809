  // 閫氱敤鐨?profile 閮ㄥ垎鏇存柊锛堜粎鍦ㄤ笉娑夊強璁よ瘉瀛楁鏃朵娇鐢級
  Future<void> _upsertProfilePartial(Map<String, dynamic> patch) async {
    final u = currentUser;
    if (u == null) return;
    await supabase.from('profiles').upsert({
      'id': u.id,
      'updated_at': DateTime.now().toIso8601String(),
      ...patch,
    }, onConflict: 'id');
  }

