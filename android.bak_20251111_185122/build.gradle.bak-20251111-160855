// Root build.gradle — force Kotlin libs to 2.0.21 for all modules
subprojects {
  configurations.all {
    resolutionStrategy.eachDependency { details ->
      if (details.requested.group == "org.jetbrains.kotlin") {
        details.useVersion "2.0.21"
        details.because("Align Kotlin stdlib/tools with AGP 8.6.1")
      }
    }
  }
}
