/**
 * Root build.gradle for Flutter Android — no repositories here.
 * All repos live in settings.gradle (repositoriesMode FAIL_ON_PROJECT_REPOS).
 */
subprojects {
    project.buildDir = "${rootProject.buildDir}/${project.name}"
    project.evaluationDependsOn(':app')
}

tasks.register("clean", Delete) {
    delete rootProject.buildDir
}