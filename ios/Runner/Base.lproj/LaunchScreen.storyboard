<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0"
  toolsVersion="12121" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none"
  useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="VC">
  <dependencies>
    <deployment identifier="iOS"/>
    <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
  </dependencies>
  <scenes>
    <scene sceneID="SC">
      <objects>
        <viewController id="VC" sceneMemberID="viewController">
          <view key="view" contentMode="scaleToFill" id="ROOT" translatesAutoresizingMaskIntoConstraints="NO">
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <!-- 背景色 #319AFF (0.192, 0.604, 1.0) -->
            <color key="backgroundColor" red="0.192" green="0.604" blue="1.0" alpha="1"
                   colorSpace="custom" customColorSpace="sRGB"/>
            <subviews>
              <!-- 居中显示合成图片（不拉伸） -->
              <imageView id="IMG" contentMode="center" translatesAutoresizingMaskIntoConstraints="NO"
                         image="SplashStacked"/>
            </subviews>
            <constraints>
              <constraint firstItem="IMG" firstAttribute="centerX" secondItem="ROOT" secondAttribute="centerX" id="cx"/>
              <constraint firstItem="IMG" firstAttribute="centerY" secondItem="ROOT" secondAttribute="centerY" id="cy"/>
            </constraints>
          </view>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="FR" userLabel="First Responder" sceneMemberID="firstResponder"/>
      </objects>
      <point key="canvasLocation" x="0" y="0"/>
    </scene>
  </scenes>
  <resources>
    <!-- 这里的名字必须等于你 imageset 的名字：SplashStacked -->
    <image name="SplashStacked" width="1024" height="906"/>
  </resources>
</document>
