<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleDisplayName</key>
    <string>Swaply</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Swaply</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- 淇敼澶?锛氬厑璁告樉绀虹姸鎬佹爮 -->
    <key>UIStatusBarHidden</key>
    <false/>

    <!-- 淇敼澶?锛氱敱鎺у埗鍣ㄥ喅瀹氱姸鎬佹爮鏍峰紡 -->
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- 闅愮鏉冮檺 -->
    <key>NSCameraUsageDescription</key>
    <string>This app needs camera access to take photos for your listing.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>This app needs access to your photo library to upload listing images.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>This app needs permission to save photos to your library when you save or export images.</string>

    <!-- Flutter 娣遍摼杞彂 -->
    <key>FlutterDeepLinkingEnabled</key>
    <true/>

    <!-- URL Schemes锛氬厛鍔?Supabase 榛樿锛屽啀淇濈暀浣犵殑 swaply -->
    <key>CFBundleURLTypes</key>
    <array>
      <!-- Supabase Flutter 榛樿 iOS 鍥炶皟 Scheme锛堝繀椤绘湁锛?-->
      <dict>
        <key>CFBundleURLName</key>
        <string>supabase.auth</string>
        <key>CFBundleURLSchemes</key>
        <array>
        <string>cc.swaply.app</string>
          <string>io.supabase.flutter</string>
        </array>
      </dict>
      <!-- 浣犵殑鑷畾涔?scheme锛堝彲閫変繚鐣欙級 -->
      <dict>
        <key>CFBundleURLName</key>
        <string>swaply.login</string>
        <key>CFBundleURLSchemes</key>
        <array>
        <string>cc.swaply.app</string>
          <string>swaply</string>
        </array>
      </dict>
    </array>

    <!-- 鍏佽 canOpenURL 鐨勫閮?App 鐧藉悕鍗?-->
    <key>LSApplicationQueriesSchemes</key>
    <array>
      <string>whatsapp</string>
      <string>whatsapp-business</string>
      <string>tg</string>
      <string>telegram</string>
      <string>fb</string>
      <string>fbapi</string>
      <string>fbauth2</string>
      <string>fb-messenger</string>
      <string>fb-messenger-share-api</string>
      <string>facebook</string>
      <string>tel</string>
      <string>mailto</string>
    </array>
  </dict>
</plist>

